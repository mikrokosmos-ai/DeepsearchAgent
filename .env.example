# DeepSearch Agents 环境变量示例
#
# 用法：复制本文件为 .env，然后按本机实际情况填写密钥与地址。
# 注意：.env 含真实密钥，不要提交到版本库。

# ===== 日志 =====
# 控制台与文件双通道可独立开关；文件日志按自然日切分并保留 LOG_FILE_RETENTION 天
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
# 监控事件（工具开始 / 助手调用 / 节点进度）的日志出口级别
# 缺省跟随 LOG_CONSOLE_LEVEL；调成 DEBUG 可静音这些过程日志
LOG_MONITOR_LEVEL=INFO

# ===== LLM / VLM =====
# 百炼 OpenAI 兼容模式；OPENAI_API_KEY 同时用于百炼 MCP 联网检索鉴权
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
# LLM_QWEN_MAX 供现有 app/agent/llm.py 使用；LLM_DEFAULT_MODEL 供 RAG 链路配置类使用
LLM_QWEN_MAX=qwen-max
LLM_DEFAULT_MODEL=qwen3.7-flash
LLM_DEFAULT_TEMPERATURE=0.1
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=2
# 视觉语言模型：图片摘要节点用它把图片内容转写成可检索文本
VL_MODEL=qwen-vl-max

# ===== Tavily 联网搜索 =====
# 在 https://app.tavily.com/ 注册后创建 API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY

# ===== 百炼 MCP 联网检索（查询链路第 3 路）=====
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ===== MinerU 云端 PDF 解析 =====
MINERU_API_TOKEN=你的_MINERU_TOKEN
MINERU_BASE_URL=https://mineru.net/api/v4

# ===== MySQL（业务数据仓库，与 RAG 无关）=====
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# docker-compose.yaml 映射到 3307，避免与本机已有 MySQL 的 3306 冲突
MYSQL_PORT=3306
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# ===== Milvus 向量库 =====
# 必须带 http:// 前缀（pymilvus 3.x 会把纯 host:port 判为非法 URI）
MILVUS_URL=http://127.0.0.1:19530
# 以下 *_PORT 仅用于 docker-compose.rag.yaml 的宿主机端口插值，应用层不读取
MILVUS_PORT=19530
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_MINIO_API_PORT=9002
MILVUS_MINIO_CONSOLE_PORT=9003
MILVUS_METRICS_PORT=9091
ATTU_PORT=8010
MONGO_PORT=27017
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# 三个集合：分块 / 商品主体 / 图谱实体（沿用 EcomKbAgent 的 kd_db_* 命名）
CHUNKS_COLLECTION=kd_db_chunks
ITEM_NAME_COLLECTION=kd_db_item_names
ENTITY_NAME_COLLECTION=kd_db_entity_names
EMBEDDING_DIM=1024

# ===== MongoDB（会话历史 + 商品名确认记忆）=====
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=deepsearch_rag

# ===== Neo4j 知识图谱 =====
# 用户名密码需与 docker-compose.rag.yaml 的 NEO4J_AUTH 保持一致
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123456
NEO4J_DATABASE=neo4j

# ===== MinIO 对象存储（存放 MinerU 解析出的图片）=====
# 注意：此处是业务 MinIO（9000/9001），与 Milvus 内部 MinIO（9002/9003）是两个实例
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ===== 本地模型 =====
# BGE_M3_PATH / BGE_RERANKER_LARGE 指向 ModelScope 缓存的快照目录，避免运行期回源下载
BGE_M3_PATH=D:/pycharm/ai_models/modelscope_cache/models/embedding/models/BAAI--bge-m3/snapshots/master
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cuda:0
BGE_FP16=1
BGE_RERANKER_LARGE=D:/pycharm/ai_models/modelscope_cache/models/rerank/models/BAAI--bge-reranker-large/snapshots/master
BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_FP16=1
# 是否在服务启动时预热本地模型（true 会占用显存并延长启动时间；默认懒加载）
WARMUP_ENABLE=false

# ===== 导入链路调参 =====
CHUNK_MAX_SIZE=500
CHUNK_SIZE=200
CHUNK_OVERLAP=20
CHUNK_MIN_SIZE=100
# 表格超长分批时每批最多带多少数据行（每批都重复表头）
CHUNK_TABLE_MAX_ROWS=20
ITEM_NAME_CHUNK_K=5
ITEM_NAME_CONTEXT_MAX_CHARS=2500
EMBEDDING_BATCH_SIZE=5
# 送入向量的文本模板（占位符 {item_name} / {content} / {section_path}）
# 第 1 步（模板外置）的零漂移现值是「主体:{item_name},内容:{content}」；
# 第 2 步起加章节路径（只取末两级）。改它等于改向量口径，必须按主体全量重导
EMBEDDING_TEMPLATE=章节路径:{section_path} | 主体:{item_name} | 内容:{content}
# 模板与长块正文前缀取章节路径的末几级标题（长路径会稀释向量，故只取末两级）
EMBEDDING_SECTION_LEVELS=2
IMAGE_SUMMARY_RATE_MAX_REQUESTS=9
IMAGE_SUMMARY_RATE_WINDOW_SECONDS=60
ENTITY_NAME_MAX_LENGTH=15

# ===== 查询链路调参 =====
RERANK_MAX_TOPK=10
RERANK_MIN_TOPK=3
RERANK_MIN_LOCAL_KEEP=3
RERANK_GAP_RATIO=0.25
RERANK_GAP_ABS=0.5
RRF_K=60
RRF_TOP=10
RRF_KG_WEIGHT=0.7
ITEM_NAME_HIGH_THRESHOLD=0.65
ITEM_NAME_MID_THRESHOLD=0.50
ITEM_NAME_MAX_OPTIONS=2
ITEM_NAME_MATCH_DENSE_WEIGHT=0.5
ITEM_NAME_MATCH_SPARSE_WEIGHT=0.5
CHUNK_SEARCH_DENSE_WEIGHT=0.8
CHUNK_SEARCH_SPARSE_WEIGHT=0.2
CHUNK_SEARCH_LIMIT=12
MAX_CONTEXT_CHARS=12000
LOCAL_EVIDENCE_BUDGET=8000
WEB_EVIDENCE_BUDGET=2500
KG_EVIDENCE_BUDGET=2000
WEB_SEARCH_COUNT=10
KG_MAX_SEED_CANDIDATES=3
KG_MAX_TOTAL_TRIPLES=50
FALLBACK_SEARCH_LIMIT=3
FALLBACK_MIN_KEEP=0
RRF_FALLBACK_WEIGHT=1.0

# ===== Redis（记忆层热层：短期会话 checkpointer + 后续的缓存与锁）=====
# 不可达时服务仍可启动：checkpointer 回退进程内内存实现、缓存回源权威库。
# 连接超时刻意取小值（默认 2s），避免「Redis 没起来」把服务启动拖成几十秒。
REDIS_URL=redis://127.0.0.1:6379/0
# 以下 *_PORT / *_MAXMEMORY 仅用于 docker-compose.yaml 的插值，应用层不读取
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb
REDIS_MAX_CONNECTIONS=16
REDIS_SOCKET_TIMEOUT_S=5
REDIS_CONNECT_TIMEOUT_S=2
REDIS_HEALTH_CHECK_INTERVAL_S=30

# ===== 记忆层（阈值单点派生，见 app/core/memory/config.py）=====
# MEMORY_CONTEXT_BUDGET_CHARS 是唯一业务数字，其余阈值全部按固定比例派生；
# 注意它不是模型标称窗口的字符换算值（人设 / 工具 schema / 输出预留 / 记忆注入块不走这份账）。
MEMORY_ENABLE=true
MEMORY_CONTEXT_BUDGET_CHARS=120000
# checkpointer 的 key 前缀与 TTL（秒）；TTL<=0 表示永不过期
MEMORY_CKPT_PREFIX=dsa:ckpt:
MEMORY_CKPT_TTL_S=604800
# 读检查点时续期，让读多写少的活跃会话不因「只读」而丢热数据
MEMORY_CKPT_REFRESH_ON_READ=true

# 会话消息热窗口：读最近若干轮先走 Redis，miss 回源 Mongo 后回填；
# 写入走「失效」而非覆盖，避免并发下把旧窗口盖回去
MEMORY_CONV_CACHE_ENABLE=true
MEMORY_CONV_PREFIX=dsa:conv:
MEMORY_CONV_TTL_S=3600

# ---- 记忆层：中期摘要压缩----
# 摘要压缩总开关；关闭时回退到底座默认（deepagents 内置摘要，约 17 万 token 触发）
MEMORY_COMPACT_ENABLE=true
# 摘要当前代缓存（Redis）：key 前缀与 TTL（秒）
MEMORY_SUMMARY_PREFIX=dsa:summary:
MEMORY_SUMMARY_TTL_S=604800

# ---- 记忆层：长期记忆独立库----
# 键名刻意与业务库的 MYSQL_* ：长期记忆需要写权限，但仅限 deepsearch_memory 库
MEMORY_DB_HOST=localhost
MEMORY_DB_PORT=3306
MEMORY_DB_USER=AXW
MEMORY_DB_PASSWORD=axw0505
MEMORY_DB_NAME=deepsearch_memory
MEMORY_DB_CHARSET=utf8mb4
# 长期记忆总开关（注入 + 抽取 + 整理工具）；关闭时三者一并停用
MEMORY_LONG_TERM_ENABLE=true
# 抽取开关：允许「只注入不抽取」（例如临时停掉后台模型调用）
MEMORY_EXTRACT_ENABLE=true
# 注入块的当前代缓存（Redis）
MEMORY_LTM_PREFIX=dsa:ltm:
MEMORY_LTM_TTL_S=604800
